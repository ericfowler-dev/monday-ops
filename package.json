{
  "name": "stack-svy-report-render",
  "version": "1.0.0",
  "description": "Monday.com report scripts",
  "main": "generate-email-report.js",
  "scripts": {
    "start": "node generate-email-report.js",
    "dev": "nodemon generate-email-report.js",
    "pdx:report": "node generate-pdx-daily-report.js",
    "pdx:test-graph": "node test-pdx-graph-mail.js",
    "snap:report": "node generate-snap-orders-report.js",
    "snap:preview": "node generate-snap-orders-report.js --force --dry-run",
    "snap:test": "node --test snap-orders-report-core.test.js",
    "movement:report": "node generate-dynamic-owner-preview.js --send",
    "movement:preview": "node generate-dynamic-owner-preview.js",
    "movement:legacy-preview": "node generate-weekly-movement-report.js --force --dry-run",
    "movement:dynamic-preview": "node generate-dynamic-owner-preview.js",
    "movement:test": "node --test weekly-movement-core.test.js dynamic-owner-activity-core.test.js generate-dynamic-owner-preview.test.js",
    "snap:dashboard:dev": "npm --prefix snap-dashboard run dev:mock",
    "snap:dashboard:test": "npm --prefix snap-dashboard test",
    "snap:dashboard:build": "npm --prefix snap-dashboard run build",
    "snap:approval:dev": "npm --prefix SNAP-FORM/snap-approval-poc run dev",
    "snap:approval:test": "npm --prefix SNAP-FORM/snap-approval-poc test",
    "snap:approval:build": "npm --prefix SNAP-FORM/snap-approval-poc run build"
  },
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@mondaydotcomorg/api": "^1.0.0",
    "dotenv": "^17.2.3",
    "isomorphic-fetch": "^3.0.0",
    "nodemailer": "^9.0.3",
    "redis": "^5.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
